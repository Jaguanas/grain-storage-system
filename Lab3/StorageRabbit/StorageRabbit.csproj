<Project Sdk="Microsoft.NET.Sdk">
	<!-- Storage server: consumes requests from RabbitMQ and forwards them to StorageLogic. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NLog" Version="6.2.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Shared\StorageContract\StorageContract.csproj" />
		<ProjectReference Include="..\..\Shared\StorageCore\StorageCore.csproj" />
		<!-- Only for RPCMessage and RabbitNames. The server never uses StorageClient. -->
		<ProjectReference Include="..\StorageRabbitTransport\StorageRabbitTransport.csproj" />
	</ItemGroup>
</Project>
